// Copy this file to Secrets.xcconfig (same folder) and fill in your keys.
// Secrets.xcconfig is git-ignored.

// https://developer.spotify.com/dashboard — add redirect URI: spotifyrecs://callback
SPOTIFY_CLIENT_ID = your_spotify_client_id

// https://www.last.fm/api/account/create
LASTFM_API_KEY = your_lastfm_api_key
